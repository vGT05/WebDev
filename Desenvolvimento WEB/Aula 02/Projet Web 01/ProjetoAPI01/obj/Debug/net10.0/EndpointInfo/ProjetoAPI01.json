{
  "openapi": "3.1.1",
  "info": {
    "title": "ProjetoAPI01 | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5143"
    }
  ],
  "paths": {
    "/api/usuarios/login": {
      "post": {
        "tags": [
          "ProjetoAPI01"
        ],
        "operationId": "LoginUsuario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/admin": {
      "get": {
        "tags": [
          "ProjetoAPI01"
        ],
        "operationId": "ListarUsuariosParaAdmin",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/admin/{id}": {
      "put": {
        "tags": [
          "ProjetoAPI01"
        ],
        "operationId": "AtualizarStatusAdmin",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminUpdateDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminUpdateDTO": {
        "type": "object",
        "properties": {
          "statusWIFI": {
            "type": "string"
          },
          "statusAction": {
            "type": "string"
          }
        }
      },
      "LoginRequestDTO": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "senha": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ProjetoAPI01"
    }
  ]
}