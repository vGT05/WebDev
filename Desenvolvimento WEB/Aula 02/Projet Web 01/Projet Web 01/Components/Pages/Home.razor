@page "/"
@using Projet_Web_01.Components.Pages.Parciais

<PageTitle>Casa</PageTitle>
<CabecalhoPagina/>
<!-- Isso é um comentário em HTML -->
<main class="corpo-pagina">
    <div class="log-container">
        <div class="login-cabecalho">
            <h1 class="login-titulo">Acesso ao WI-FI</h1>
            <p class="login-subtitulo">Sistema de gestão WI-FI</p>
        </div>
        <form class="login-form">
            <!--implementar validaçâo de campos-->
            <div class="form-grupo">
                <label>E-mail institucional</label>
                <div class="imput-w">
                    <input type="email" id="email" class="form-input" placeholder="user@sp.senai.br"/>
                </div>
            </div>
            <div class="form-grupo">
                <label>Senha</label>
                <div class="input-w">
                    <input type="password" id="senha" class="form-input" placeholder="******"/>
                </div>
            </div>
            <button type="button" id="btn-entrar" class="btn=login">
                Login
            </button>
        </form>
    </div>
</main>









